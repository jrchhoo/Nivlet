index 1f0d2fb..a05174d 100644
--- a/Hammerspoon/MJAppDelegate.m
+++ b/Hammerspoon/MJAppDelegate.m
@@ -214,8 +214,30 @@
         [self showConsoleWindow:nil];
     } else {
         // No test environment detected, this is a live user run
-        NSString* userMJConfigFile = [[NSUserDefaults standardUserDefaults] stringForKey:@"MJConfigFile"];
-        if (userMJConfigFile) MJConfigFile = userMJConfigFile ;
+        // DesktopToolkit owns its bootstrap and never loads personal Hammerspoon config.
+        NSBundle *bundle = [NSBundle mainBundle];
+        if (![bundle.bundleIdentifier isEqualToString:@"dev.local.DesktopToolkit"]) abort();
+        // Do not allow competing instances to register the same global shortcuts.
+        for (NSRunningApplication *running in [NSRunningApplication runningApplicationsWithBundleIdentifier:bundle.bundleIdentifier]) {
+            if (running.processIdentifier != NSProcessInfo.processInfo.processIdentifier && !running.terminated) {
+                [running activateWithOptions:NSApplicationActivateIgnoringOtherApps];
+                [NSApp terminate:nil];
+                return;
+            }
+        }
+        NSString *support = [NSSearchPathForDirectoriesInDomains(NSApplicationSupportDirectory, NSUserDomainMask, YES) firstObject];
+        NSString *directory = [support stringByAppendingPathComponent:bundle.bundleIdentifier];
+        NSError *bootstrapError = nil;
+        if (![[NSFileManager defaultManager] createDirectoryAtPath:directory withIntermediateDirectories:YES attributes:nil error:&bootstrapError]) {
+            NSLog(@"DesktopToolkit bootstrap directory failed: %@", bootstrapError);
+            abort();
+        }
+        MJConfigFile = [directory stringByAppendingPathComponent:@"init.lua"];
+        NSString *bootstrap = @"dofile(hs.processInfo.bundlePath .. \"/Contents/Resources/Toolkit/init.lua\")\n";
+        if (![bootstrap writeToFile:MJConfigFile atomically:YES encoding:NSUTF8StringEncoding error:&bootstrapError]) {
+            NSLog(@"DesktopToolkit bootstrap write failed: %@", bootstrapError);
+            abort();
+        }
 
         // Ensure we have a Spoons directory
         NSString *spoonsPath = [MJConfigDirAbsolute() stringByAppendingPathComponent:@"Spoons"];
